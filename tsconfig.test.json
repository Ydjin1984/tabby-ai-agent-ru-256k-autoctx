{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2021",
    "outDir": ".test-out",
    "declaration": false,
    "sourceMap": false,
    "noUnusedLocals": false,
    "types": ["node"]
  },
  "include": [
    "src/lib/model_presets.ts",
    "src/lib/llm_endpoint.ts",
    "src/lib/request_defaults.ts",
    "src/memory/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".test-out"]
}
